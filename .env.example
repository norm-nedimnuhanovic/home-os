# Copy this file to .env and fill in real values — see README.md "Getting Started" §2.
# Never commit the real .env (already covered by .gitignore).
#
# Local dev: run `npx supabase start` (Docker) instead of provisioning a real
# project, then copy the DB_URL/API_URL/ANON_KEY/SERVICE_ROLE_KEY from
# `npx supabase status` into the values below — no [PLACEHOLDER] filling-in
# needed, `supabase start` always prints the same well-known local demo keys.

# Supabase → Project Settings → Database → connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# http://localhost:3000 locally; the deployed URL (e.g. https://home-os.vercel.app) elsewhere.
# Used to build Supabase Auth email redirect links (docs/auth.md §2.2).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend → API Keys
RESEND_API_KEY=""
EMAIL_FROM="Home OS <notifications@yourdomain.com>"
# Optional, non-production only — redirects every outgoing email's envelope
# recipient to this address (e.g. your own inbox) instead of the real
# member. Emails are still genuinely sent via Resend, never
# simulated/logged (docs/email.md §7).
EMAIL_DEV_REDIRECT_TO=""

# Any random string — shared secret checked by src/app/api/cron/* routes
# so only Vercel Cron (or you, locally) can trigger them.
CRON_SECRET=""

# Never set this to "true" in a Vercel Production/Preview environment
# variable, and never against a real hosted Supabase project — local dev /
# sandboxed agent runs only. Gates whether `pnpm db:seed` also creates real
# Supabase Auth accounts for the 3 seeded members (sam/priya/jordan@seed.local),
# so you can actually log in locally as one of them (docs/seeding.md §7.2).
# Leave "false" (the default) to only seed DB rows — Prisma Studio browsing,
# visibility checks, etc. all still work without it.
ALLOW_DEV_SEED_AUTH_USERS=false
