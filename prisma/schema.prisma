  expiring_soon
  expired
  renewed
  cancelled
}

enum ContactCategory {
  medical
  emergency_services
  home_service_provider
  insurance_agent
  landlord_property_manager
  school_childcare
  financial_legal
  utility_provider
  family_friend
  other
