// Home OS — Prisma schema
// Single file per docs/orm-conventions.md §1. Organized into ordered section
// banners matching plan.md §3.1–§3.6. Every scoped model carries householdId
// + @@index([householdId]) per docs/orm-conventions.md §3.1, even when it's
// derivable from a parent relation (denormalized for query performance and
// tenant-isolation guarantees). Platform-catalog models (Module,
// ModuleEventType, EventSubscription, ModulePermissionDeclaration,
// ModuleSurfaceRegistration) are the only ones without householdId — see
// docs/orm-conventions.md §2.1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

